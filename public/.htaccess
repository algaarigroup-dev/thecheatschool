# Single page app routing for Apache / LiteSpeed hosting (Hostinger, cPanel).
# Without this, opening any link other than the homepage directly returns the
# host's 404 page, because the server looks for a real file at that path.
# /blogs is both a page (blogs.html) and a folder of articles (blogs/*.html).
# Stop Apache adding a slash to folder URLs so /blogs serves the page.
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Drop trailing slashes (except the homepage) so each page has one URL
  RewriteRule ^(.+)/$ /$1 [L,R=301]

  # Serve real files as they are (assets, images, sitemap)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Serve the prerendered page for a route if one exists (/civil-engineering -> civil-engineering.html)
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+)$ /$1.html [L]

  # Everything else (blog posts, unknown paths) goes to the app
  RewriteRule ^ /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Never cache HTML, so new deploys show up immediately
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Hashed build assets can be cached for a year
  <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
